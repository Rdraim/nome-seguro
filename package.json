{
  "name": "nome-seguro",
  "version": "1.2.1",
  "description": "Sanitize a filename into one safe path segment, with Windows reserved-name handling and a UTF-8 byte limit.",
  "type": "module",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test",
    "check:public": "node tools/check-public-content.mjs",
    "check": "node --check src/index.js",
    "example": "node examples/uso.mjs"
  },
  "keywords": [
    "filename",
    "sanitize",
    "sanitization",
    "security",
    "path-traversal",
    "upload",
    "seguranca",
    "nome-arquivo",
    "windows-reserved"
  ],
  "author": "Rodrigo Rodrigues",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rdraim/nome-seguro.git"
  }
}
